// Cloudflare Worker for the social hub (docs/egm/2026-11-16_social-hub.md).
// Secrets (never in git): ADMIN_EMAIL (the only account allowed into /admin) and INSTAGRAM_TOKEN.
// Set each with `npx wrangler secret put <NAME>`. For local dev put them in .dev.vars (gitignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harish-social",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Pull the live sources every 30 minutes.
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harish-social",
      // Replaced with the real id after `npx wrangler d1 create harish-social` (go-live phase).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://harishkumartn.in,http://localhost:5173",
    // Filled in during go-live from the Cloudflare Access application. Empty means every /admin request is refused.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // youtube.com/@harishkumar_tn
    "YOUTUBE_CHANNEL_ID": "UC1LVB92eIBvXml8xUFmm0HQ"
  }
}
