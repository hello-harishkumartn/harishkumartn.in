// Cloudflare Worker for the social hub (docs/egm/2026-11-16_social-hub.md).
// Secret (never in git): ADMIN_PASSWORD, at least 24 characters, unlocks /admin/api.
// Set it with `npx wrangler secret put ADMIN_PASSWORD`. For local dev put it in .dev.vars (gitignored).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harish-social",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Pull the live sources every 30 minutes.
  "triggers": { "crons": ["*/30 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harish-social",
      // Created 2026-11-17 with `npx wrangler d1 create harish-social` (region APAC).
      "database_id": "5e0cad07-8034-4473-9ba9-e558de94c376",
      "migrations_dir": "migrations"
    }
  ],
  // Preview images copied from the platforms (docs/egm revision 5). Created 2026-11-17 with `npx wrangler kv namespace create MEDIA`.
  "kv_namespaces": [{ "binding": "MEDIA", "id": "02c707a857e04c10a1dd70862228846e" }],
  // Checked before the admin password: 30 admin API calls a minute per client address.
  "ratelimits": [
    { "name": "ADMIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://harishkumartn.in,http://localhost:5173",
    // youtube.com/@harishkumar_tn
    "YOUTUBE_CHANNEL_ID": "UC1LVB92eIBvXml8xUFmm0HQ"
  }
}
